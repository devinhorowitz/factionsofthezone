<w>
<!--
    Factions of the Zone: the Factions page (ui_fotz_tab.script).

    The PDA's page area, 1024x768, with the content in the PDA's own background rectangle
    (28,106 to 792,709), laid out the way Seasons' and Arsenal's pages are: a chamfered frame
    with its corners left open, a header block with a rule under it, a row of subpage buttons, the
    subpage in a scroll view, and a footer under a rule. The lines (the script's, from px) group
    things; they aren't there to be looked at.

    The header: your side's icon, name and a line on it; at its right Back to the launcher (from
    Mod App Creator's tile). Under it the subpages' buttons (Relations, Fighting, Members while you
    lead a faction, War log), placed left to right by the script, the one shown with its label in
    amber and a line under it. The footer: whether politics is in charge, the PDA's own Relations
    tab (the numbers; from the PDA only), and the credit.

    A subpage is built anew into one box (box), which then goes into the scroll view (view): the
    row_*, request_* and line elements are its templates, placed one under another by the script,
    so their y here is the offset within a row. Every line wraps and is placed by its real height;
    the box is 16 narrower than the view, for the view's bar.

    Art: the game's own faction icons (set from script), its ordinary button, for the flat window
    the 2D PDA's frame, and this mod's one white pixel (fotz_px), tinted from script. Colors
    follow the PDA: amber 238,196,112 for headings, light gray for text, dim gray for detail.
    Fonts are letterica, as everywhere else.
-->
    <!-- the flat window only: the 2D PDA's frame and the page's name where the PDA prints a
         section's, at pda_16.xml's offsets -->
    <flat_bezel x="-10" y="-34" width="819" height="768" stretch="1">
        <texture>ui_inGame2_pda_texture</texture>
    </flat_bezel>
    <flat_caption x="29" y="28" width="748" height="17">
        <text font="letterica16" align="l" r="170" g="170" b="170"/>
    </flat_caption>

    <background x="28" y="106" width="764" height="603" stretch="1"/>

    <!-- one white pixel block, tinted and stretched per line: X-Ray has no fill-rect -->
    <px x="0" y="0" width="8" height="8" stretch="1">
        <texture>fotz_px</texture>
    </px>

    <!-- ============ the header: your side ============ -->
    <icon x="52" y="120" width="44" height="44" stretch="1"/>
    <title x="106" y="118" width="410" height="24">
        <text font="letterica18" r="238" g="196" b="112" align="l" vert_align="c"/>
    </title>
    <subtitle x="106" y="146" width="662" height="18">
        <text font="letterica16" r="200" g="200" b="200" align="l" vert_align="c"/>
    </subtitle>

    <!-- Back to Mod App Creator's launcher, while the page has its tile there -->
    <back x="676" y="118" width="92" height="26">
        <texture>ui_button_ordinary</texture>
    </back>
    <back_label x="676" y="123" width="92" height="16">
        <text font="letterica16" r="220" g="220" b="220" align="c" vert_align="c"/>
    </back_label>

    <!-- ============ the subpages' buttons; x is the script's ============ -->
    <subpage x="0" y="176" width="160" height="26">
        <texture>ui_button_ordinary</texture>
    </subpage>
    <subpage_label x="0" y="181" width="160" height="16">
        <text font="letterica16" r="220" g="220" b="220" align="c" vert_align="c"/>
    </subpage_label>

    <!-- ============ the subpage shown ============ -->
    <view x="52" y="212" width="716" height="412" vert_interval="0" always_show_scroll="0" stretch="1"/>
    <box x="0" y="0" width="700" height="8" stretch="1"/>

    <!-- Relations: a faction a row, two lines -->
    <row_icon x="0" y="2" width="28" height="28" stretch="1"/>
    <row_name x="36" y="0" width="210" height="16">
        <text font="letterica16" r="220" g="220" b="220" align="l" vert_align="c"/>
    </row_name>
    <!-- its leader -->
    <row_detail x="36" y="16" width="210" height="16">
        <text font="letterica16" r="150" g="150" b="150" align="l" vert_align="c"/>
    </row_detail>
    <!-- the way it went on politics' last day: the game's small arrow, tinted from script -->
    <row_trend x="254" y="3" width="9" height="10" stretch="1"/>
    <row_standing x="268" y="0" width="150" height="16">
        <text font="letterica16" r="200" g="200" b="200" align="l" vert_align="c"/>
    </row_standing>
    <!-- the event holding it, under its standing -->
    <row_event x="268" y="16" width="200" height="16">
        <text font="letterica16" r="150" g="150" b="150" align="l" vert_align="c"/>
    </row_event>
    <row_change x="430" y="0" width="200" height="16">
        <text font="letterica16" r="150" g="150" b="150" align="l" vert_align="c"/>
    </row_change>

    <!-- a line of any subpage, wrapping onto as many as it needs; tinted from script -->
    <line x="0" y="0" width="700" height="16">
        <text font="letterica16" r="200" g="200" b="200" complex_mode="1" align="l" vert_align="t"/>
    </line>

    <!-- Members: a join request (fotz_loyalty), its line, and Accept and Decline at its right -->
    <request_line x="0" y="3" width="480" height="16">
        <text font="letterica16" r="238" g="196" b="112" complex_mode="1" align="l" vert_align="t"/>
    </request_line>
    <request_accept x="500" y="0" width="96" height="22">
        <texture>ui_button_ordinary</texture>
    </request_accept>
    <request_accept_label x="500" y="3" width="96" height="16">
        <text font="letterica16" r="220" g="220" b="220" align="c" vert_align="c"/>
    </request_accept_label>
    <request_decline x="604" y="0" width="96" height="22">
        <texture>ui_button_ordinary</texture>
    </request_decline>
    <request_decline_label x="604" y="3" width="96" height="16">
        <text font="letterica16" r="220" g="220" b="220" align="c" vert_align="c"/>
    </request_decline_label>

    <!-- ============ the footer ============ -->
    <!-- whether politics is in charge, or why not -->
    <status x="52" y="640" width="516" height="18">
        <text font="letterica16" r="200" g="200" b="200" align="l" vert_align="c"/>
    </status>
    <!-- the PDA's own Relations tab, with the numbers: from the page in the PDA only; the label
         over the plate -->
    <numbers x="580" y="638" width="188" height="26">
        <texture>ui_button_ordinary</texture>
    </numbers>
    <numbers_label x="580" y="643" width="188" height="16">
        <text font="letterica16" r="220" g="220" b="220" align="c" vert_align="c"/>
    </numbers_label>

    <!-- above the frame's lower edge (the PDA's own background ends at 709) -->
    <credit x="472" y="678" width="296" height="16">
        <text font="letterica16" r="120" g="120" b="120" align="r" vert_align="c"/>
    </credit>
</w>
