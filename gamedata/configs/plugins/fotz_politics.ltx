; Factions of the Zone: the politics engine's tuning and its lore limits.
; Another mod can change any line here with DLTX (a mod_fotz_politics_*.ltx with ![section]).
;
; Relations run from -5000 to 5000. Two factions are enemies at -1000 or below and friends at
; 1000 or above. Each pair's change is kept apart from the relation the game starts it with, so
; turning the engine off, or removing the mod, puts every pair back where the game had it.

[politics]
kill            = -12   ; per kill between two factions, times the victim's rank weight below
player_kill     = 0.5   ; a kill by the player counts this much, for the player's own faction
ground          = -150  ; per smart terrain one faction took from the other since the day before
front           = -40   ; per smart terrain where both are fighting today
common_enemy    = 60    ; per day, for two factions at war with the same third
recover         = 0.1   ; the share of a pair's change that fades each day, except at war or in an alliance
daily_budget    = 400   ; the most a pair's relation moves in one day; the rest waits
pending_max     = 1500  ; the most change a pair can have waiting
limit           = 4750  ; changed relations stay inside +-limit
min_war_days    = 3     ; a war lasts at least this many days
quiet_days      = 2     ; days without fighting between them before a war ends in a truce
max_war_days    = 14    ; a war ends in a truce after this many days even if the fighting goes on
truce_relation  = -600  ; where a truce sets the pair
truce_days      = 5     ; how long a truce holds; while it does, new grievances count half
history         = 50    ; how many past events the save keeps

; the territory steer (fotz_territory): a squad's score for a smart held by a faction its own is at
; war with is multiplied by 1 + k * (2 * share - 1), its faction's share of the two factions'
; fighters on that level, kept within lo and hi. A bias in the game's own target choice, no orders.
[territory]
k               = 0.5   ; how hard the share pulls: 0.5 gives 1.25 at three to one, 0.75 at one to three
lo              = 0.6   ; the least a losing front is weighed
hi              = 1.5   ; the most a winning front is weighed

; the victim's rank, for kills
[rank_weight]
novice          = 1
trainee         = 1
experienced     = 1.5
professional    = 1.5
veteran         = 2
expert          = 2.5
master          = 3
legend          = 4

; how far each pair may move from where the game starts it, as lowest, highest
; a pair's own line is the two faction names in name order, joined by "_": csky_killer = -4000, 1000
[caps]
default         = -3000, 2500

; factions whose relations never change (as the base game's dynamic relations)
[fixed_factions]
monolith
greh
isg
renegade
greh_npc
army_npc
trader
monster
zombied

; pairs whose relation never changes (the base game's lore pairs)
[fixed_pairs]
pair_1          = army,bandit
pair_2          = army,dolg
pair_3          = army,ecolog
pair_4          = army,stalker
pair_5          = bandit,csky
pair_6          = bandit,dolg
pair_7          = bandit,stalker
pair_9          = dolg,ecolog
pair_10         = dolg,freedom
pair_12         = dolg,stalker
pair_14         = ecolog,stalker
pair_15         = freedom,stalker

; settler loyalty (fotz_loyalty): while you lead a faction, each resident of your Homestead camps
; has a loyalty to it, 0 to 100. The terms below move it; numbers are loyalty points.
[loyalty]
; where it starts, the first day Factions sees a resident
start           = 30
same_faction    = 10    ; they came from the faction you came from
was_companion   = 10    ; they were your companion before
start_friends   = 15    ; your faction and theirs are friends (relation 1000 or more)
start_enemies   = -15   ; ... or enemies (-1000 or less)
; each game day
resident        = 5     ; living in the camp
working         = 3     ; with a job
morale_high     = 70    ; camp morale at or above this ...
morale_high_add = 2
morale_top      = 90    ; ... or this ...
morale_top_add  = 3
morale_low      = 45    ; ... or at or below this
morale_low_add  = -2
day_enemies     = -6    ; your faction and theirs are enemies, times (1 + tier / 3)
day_friends     = 2     ; ... or friends, times the same
many_wars       = 2     ; your faction at war with this many factions or more ...
many_wars_add   = -2
sworn_near      = 1     ; per sworn member living in the same camp (not themselves) ...
sworn_near_max  = 3     ; ... up to this
; events, when Factions next looks
promotion       = 10    ; a step up in Homestead's tiers (Skilled, Expert, Master)
weapon          = 3     ; a weapon bought with their savings
raid_beaten     = 6     ; a raid on their camp beaten off
raid_guard      = 10    ; ... for its guards
campmate_killed = -4
expedition_back = 2
; asking, joining, leaving, swearing
ask             = 70    ; a resident at this or more asks to join, once a day at most
withdraw        = 60    ; a waiting request is withdrawn under this
decline_cost    = 10    ; Decline costs this much ...
decline_days    = 3     ; ... and they don't ask again for this many days
leave           = 30    ; a member under this goes back to their own faction
sworn_tier      = 3     ; sworn for life: a member of this Homestead tier (Master) ...
sworn_loyalty   = 100   ; ... at this loyalty ...
sworn_days      = 14    ; ... after this many days as a member

[outposts]
; with Homestead: a rival outpost of a faction at war with you, beaten while you're there
near             = 150   ; meters: within this of an outpost you're at its fight; farther, the fight is forgotten
broken           = 0.4   ; the survivors roll at this share of the most it had, or fewer (the last one always)
defect_novice    = 30    ; the chance of coming over to you, out of 100, for novices ...
defect_step      = 4     ; ... less this a rank (rank 0 novice to 7 legend)
surrender_novice = 50    ; the chance of giving up, for novices ...
surrender_step   = 7     ; ... less this a rank
defector_loyalty = 50    ; a defector's loyalty as they set out for your camp
truce_days_min   = 1     ; a surrender's ceasefire lasts this many game days ...
truce_days_max   = 3     ; ... to this many
