--[[
Factions of the Zone: bridges to the game and to other mods.

Your faction's name. The game names a faction by its community's string, and ours, fotz_own and
its player twin actor_fotz_own, say "Your faction". While you lead one, game.translate_string gives
the name you chose for those two, so the inventory's card and every other page that names a
community from Lua show it. The engine's own pages keep the string.

Loot. G.A.M.M.A.'s NPC Loot Claim (grok_loot_claim) won't let you loot a body an NPC killed unless
a companion killed it. A member's kill is yours to loot too: their claim is dropped on the next
update, once it's made, from the claim table as it is then (a load or a level change replaces it).

Homestead, 1.3.4 and later. Its faction provider (issue #379) names your faction as the player's
while you lead one, so raids come from your faction's enemies, and gets a member's old faction for
anything Homestead saves (fotz_faction.saved_faction), so its save never holds ours. A member
never moves on from a camp (homestead_on_before_settler_leave, issue #380): their faction is yours
now. An older Homestead has neither, and nothing changes there.

Tagged Patches (Utjan). It writes who a fallen stalker was, and how they died, on the patch they
drop, for the factions in its own list; your faction joins the list, so a fallen member's patch is
tagged, and with "You join it" yours is your own. The list is a local of its script, reached
through the functions that use it, as other wrappers may stand in between.
--]]

local OWN_IDS = { fotz_own = true, actor_fotz_own = true }
local original_translate = nil
local registered = false

local function log(fmt, ...)
    printf("[fotz-bridges] " .. fmt, ...)
end

local function F()
    return fotz_faction and fotz_faction.F
end

-- your faction's name ------------------------------------------------------------------------------

-- the name in place of a community's string, or nil
function name_for(id)
    local f = F()
    if f and OWN_IDS[id] and type(f.name) == "string" and f.name ~= "" then
        return f.name
    end
end

local function translate(id, ...)
    local name = id ~= nil and name_for(id)
    if name then
        return name
    end
    return original_translate(id, ...)
end

function hook_names()
    if original_translate or not (game and game.translate_string) then
        return
    end
    original_translate = game.translate_string
    game.translate_string = translate
end

-- loot ---------------------------------------------------------------------------------------------

-- the claim on a body killed by killer_id, dropped if it's still theirs
function free_kill(victim_id, killer_id)
    local m = grok_loot_claim
    local claimed = type(m) == "table" and m.claimed
    if type(claimed) == "table" and claimed[victim_id] == killer_id then
        claimed[victim_id] = nil
        return true
    end
    return false
end

local function on_death(victim, killer)
    local f = F()
    local kid = f and victim and killer and killer:id()
    if not (kid and f.members[kid]) then
        return
    end
    local vid = victim:id()
    CreateTimeEvent("fotz_bridges", "loot_" .. vid, 0, function()
        if free_kill(vid, kid) then
            log("%s, killed by member %s: yours to loot", vid, kid)
        end
        return true
    end)
end

-- Homestead ----------------------------------------------------------------------------------------

provider = {
    get_player_faction = function()
        return F() and fotz_faction.OWN or nil
    end,
    save_safe_faction = function(comm, npc_id)
        return fotz_faction.saved_faction(comm, npc_id)
    end,
}

-- a member stays when Homestead would have them move on
function before_leave(npc_id, survivor, flags)
    local f, id = F(), tonumber(npc_id)
    if f and id and f.members[id] and type(flags) == "table" then
        flags.keep = true
        log("%s stays in your camp: a member of %s", id, f.name)
    end
end

-- on the first update, when every script has loaded: Homestead's callbacks exist only by then,
-- and only from the version that sends them
function hook_homestead()
    local hs = stalker_camp_builder
    if type(hs) ~= "table" then
        return
    end
    hs.faction_provider = provider
    if not registered and type(hs.send_settler_callback) == "function" then
        RegisterScriptCallback("homestead_on_before_settler_leave", before_leave)
        registered = true
    end
end

-- Tagged Patches -----------------------------------------------------------------------------------

-- a table a function holds as an upvalue by that name, or one a function it holds does, nearest
-- first, `depth` deep
function upvalue(fn, name, depth)
    local seen = {}
    local function search(f, d)
        if type(f) ~= "function" or seen[f] or d > (depth or 3) then
            return nil
        end
        seen[f] = true
        local nested, i = {}, 1
        while true do
            local n, v = debug.getupvalue(f, i)
            if not n then
                break
            end
            if n == name and type(v) == "table" then
                return v
            end
            if type(v) == "function" then
                nested[#nested + 1] = v
            end
            i = i + 1
        end
        for _, g in ipairs(nested) do
            local t = search(g, d + 1)
            if t then
                return t
            end
        end
    end
    return search(fn, 1)
end

-- your faction's patch in Tagged Patches' list of each faction's patch
function tag_patches()
    local tp = tagged_patches
    if type(tp) ~= "table" or type(tp.is_patch) ~= "function" or type(debug) ~= "table" then
        return false
    end
    local list = upvalue(tp.is_patch, "valid_community")
    if not list then
        log("Tagged Patches: its list of patches wasn't found, so your faction's aren't tagged")
        return false
    end
    if list[fotz_faction.OWN] ~= fotz_patch.SECTION then
        list[fotz_faction.OWN] = fotz_patch.SECTION
        log("Tagged Patches: your faction's patches are tagged")
    end
    return true
end

function on_game_start()
    hook_names()
    RegisterScriptCallback("npc_on_death_callback", on_death)
    RegisterScriptCallback("monster_on_death_callback", on_death)
    RegisterScriptCallback("actor_on_first_update", hook_homestead)
    RegisterScriptCallback("actor_on_first_update", tag_patches)
end
