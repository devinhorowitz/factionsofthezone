--[[
Factions of the Zone: territory, the light steer.

A bias, not a command. When a squad picks its next target, the game scores the smart terrains
(simulation_objects.evaluate_prior, which G.A.M.M.A. Economy's target_prior replaces) and takes one
of the best. Factions multiplies the score of a smart held by a faction the squad's own is at war
with (the game's enmity, -1000 or below, read live): up where its faction outnumbers the holder on
that level, down where it is outnumbered (on levels where both sides have fighters: fronts),
within the config's bounds. No squad's scripted target is set, no spawn rows are written, and a
score of 0 (not allowed) stays 0.

The table is rebuilt from each census (once a game day, and after each load) and the relations
then in force, the politics engine's wars among them. The same census gives the fronts the
Factions page lists, and news where a side has newly taken the upper hand on one. Left alone:
story squads, squads with a scripted target, the player's companions, Homestead's outpost
garrisons, and squads another mod claims (add_owner, or AlifePlus's owner registry). It stands
down for Warfare mode, which runs the squads itself, and with its MCM switch. One
wrapper, put in place as the game starts (after every script has loaded, so it wraps the version
G.A.M.M.A. Economy put there), and unwound when the switch goes off if it is still the one in
place. It saves nothing.

Your faction's footprint, the counterweight to its perks (fotz_perks): where your members are,
the factions hostile to them are drawn, like an immune response. A squad of faction E weighs every
smart on a level where E has fighters, or next to one (cfg.reach: nearness, about a level over),
by 1 + cap x share(draw), draw being the steps of your members hostile to E (all of them if E is
at war with your faction, else those who came from a faction E is at war with), each by how near
their level is (fotz_perks' ranks, nearness and curve), the cap MCM's slider. So Duty men in your
ranks bring Freedom's squads, from that level and the ones next to it; the curve makes a big
faction draw far more than a small one, which slips by; and a mix of members spreads the draw
over many factions, where twenty from one focus one enemy's. Rebuilt every FOOT_MS and
at each census; the same squads are left alone as by the steer.

Consequences, on ground other factions hold (a faction's share of a level's smarts, from the
census): your members settled there strain your faction's relation with it, a push on the pair in
politics each day up to cfg.encroach at a full settlement's worth of them where it holds all the
ground (members who came from that faction don't count, nor your companions; an ally doesn't mind;
and only a faction politics has a pair of yours with, not one whose relations never change); and a
stalker you kill there costs you up to cfg.instigate of its goodwill, unless it's at war with the
victim's faction (or is the victim's own: the game already counts that). Only a faction's stalker
counts (not an arena fighter, a zombie or your own member). Before the first census after a load,
a kill counts the level's ground there and then. Both while you lead a faction; MCM's sliders set
them.
--]]

VERSION = "0.6.0"
CONFIG = "plugins\\fotz_politics.ltx"
ENEMIES = -1000           -- the game's line: a faction at or below it toward another is at war

cfg = nil
STEER = {}                -- faction -> smart id -> multiplier
STATS = { calls = 0, raised = 0, lowered = 0, drawn = 0 }
local orig, wrapper       -- the scoring we wrapped, and ours
local on = false          -- steering now
local exempt = {}         -- squad id -> whether the steer leaves it alone, until the next census
local garrison = {}       -- Homestead's outpost garrisons, by squad id
FOOT_MS = 30000           -- your faction's footprint is worked out again this often
FOOT = {}                 -- faction -> level -> multiplier: your footprint's pull on its squads
local last_census = nil
local next_foot = 0
local smart_level = {}    -- target id -> its level, or false for a target that isn't a smart
INFLUENCE = {}            -- level -> faction -> its share of the level's smarts, at the last census
                          -- (before the first, a level's own count, on demand)
local FRIENDS = 1000
local is_faction = nil    -- the census's factions, as a set

local function log(fmt, ...)
    printf("[fotz-territory] " .. fmt, ...)
end

function load_config(ini)
    ini = ini or ini_file(CONFIG)
    local function num(k, d)
        return ini:r_float_ex("territory", k) or d
    end
    cfg = { k = num("k", 0.5), lo = num("lo", 0.6), hi = num("hi", 1.5), footprint = num("footprint", 0.5),
            encroach = num("encroach", 40), instigate = num("instigate", 15), reach = num("footprint_reach", 0.4) }
end

-- the multiplier for a front where one side has `mine` fighters on the level and the other `theirs`
function multiplier(mine, theirs)
    local total = (mine or 0) + (theirs or 0)
    if total <= 0 then
        return 1
    end
    local m = 1 + cfg.k * (2 * (mine or 0) / total - 1)
    return math.max(cfg.lo, math.min(cfg.hi, m))
end

local function fighters(c, f, lv)
    local e = c.factions and c.factions[f]
    local l = e and e.levels and e.levels[lv]
    return l and l.fighters or 0
end

-- other mods' squads. A squad another mod directs has a script target (a scripted target, its
-- own get_script_target, a condlist) or Xlib's lock, so the game never asks it to choose and the
-- steer never sees it. A mod that holds squads without one (a garrison kept at its post by its
-- stay time, say) can claim them here, or in AlifePlus's owner registry: the steer leaves a
-- claimed squad alone, and the squads Homestead holds. A claim that fails counts as one.
local owners = {}         -- name -> function(squad), true while that mod holds the squad
local failed = {}         -- owners whose claim has failed, logged once

function add_owner(name, fn)
    if type(name) ~= "string" or type(fn) ~= "function" then
        return false
    end
    owners[name] = fn
    return true
end

function remove_owner(name)
    owners[name] = nil
end

-- the name of the mod holding a squad, or nil
function owner_of(squad)
    for name, fn in pairs(owners) do
        local ok, mine = pcall(fn, squad)
        if not ok and not failed[name] then
            failed[name] = true
            log("! %s's claim failed, its squads are left alone: %s", name, tostring(mine))
        end
        if mine or not ok then
            return name
        end
    end
    -- Capture the Zone's campaign squads (Queen Jadwiga's mod), which it marks on the squad and
    -- holds at their forts by their stay time
    if squad.ctz_campaign_owned then
        return "ctz"
    end
    -- Homestead's camps, their reinforcements and convoys (what it registers with AlifePlus)
    local hs = stalker_camp_builder
    if hs and type(hs.is_held_squad) == "function" then
        local ok, held = pcall(hs.is_held_squad, squad)
        if held or not ok then
            return "homestead"
        end
    end
    local ap = ap_api
    if ap and type(ap.get_owner) == "function" then
        -- a lookup that fails gives its error, not nil: that squad is left alone too
        local _, name = pcall(ap.get_owner, squad)
        return name
    end
end

-- whether the steer leaves a squad alone: a story squad, the player's companions, a Homestead
-- garrison (kept per census), one with a scripted target, or one another mod claims (checked each
-- time)
local function left_alone(squad)
    local id = squad.id
    local e = exempt[id]
    if e == nil then
        local comp = axr_companions and axr_companions.companion_squads
        e = get_object_story_id(id) ~= nil or (comp ~= nil and comp[id] ~= nil) or garrison[id] == true
        exempt[id] = e
    end
    return e or squad.scripted_target ~= nil or owner_of(squad) ~= nil
end

-- the table, from a census and the wars in force; returns how many smarts it weighs
function rebuild(c)
    STEER, exempt, garrison = {}, {}, {}
    local sb = stalker_camp_builder
    if type(sb) == "table" and type(sb.rival_camps) == "table" then
        for _, camp in pairs(sb.rival_camps) do
            if type(camp) == "table" and camp.squad_id then
                garrison[camp.squad_id] = true
            end
        end
    end
    -- who is at war with whom: the game's own enmity, read live (a war the politics engine
    -- declared holds its pair there; a truce lifts it out). G.A.M.M.A. starts some pairs at -2000,
    -- enemies with no war ever declared. The census's factions only: your own has no squads
    local wars = {}
    local list = fotz_census.FACTIONS
    for _, f in ipairs(list) do
        for _, h in ipairs(list) do
            if f ~= h and relation_registry.community_relation(f, h) <= ENEMIES then
                wars[h] = wars[h] or {}
                wars[h][f] = true
            end
        end
    end
    local n = 0
    for name, holder in pairs(c and c.smarts or {}) do
        local enemies = wars[holder]
        local se = enemies and SIMBOARD.smarts_by_names[name]
        if se then
            local lv = fotz_census.level_of(se)
            for f in pairs(enemies) do
                -- a front is a level both sides are on; deep in enemy country, with none of its
                -- own there, a faction's squads choose as the game would
                local mine = fighters(c, f, lv)
                local m = mine > 0 and multiplier(mine, fighters(c, holder, lv)) or 1
                if m ~= 1 then
                    STEER[f] = STEER[f] or {}
                    STEER[f][se.id] = m
                    n = n + 1
                end
            end
        end
    end
    return n
end

-- fronts --------------------------------------------------------------------------------------

UPPER = 2 / 3             -- a side with this share of a front's fighters has the upper hand
FRONT_MIN = 10            -- fewer fighters than this on both sides together isn't news
NEWS_PER_DAY = 2
FRONTS = {}               -- the last census's fronts, the biggest first
COUNTED = false           -- whether a census has given the fronts since the load
local upper = nil         -- "a|b|level" -> the side with the upper hand (false: close), last census

-- every front in a census: a level two enemy factions both have fighters on, each pair once
function fronts(c)
    local list = fotz_census.FACTIONS
    local out = {}
    for i, a in ipairs(list) do
        for j = i + 1, #list do
            local b = list[j]
            if relation_registry.community_relation(a, b) <= ENEMIES
                or relation_registry.community_relation(b, a) <= ENEMIES then
                local la = c.factions and c.factions[a] and c.factions[a].levels or {}
                for lv, at in pairs(la) do
                    local fa, fb = at.fighters or 0, fighters(c, b, lv)
                    if fa > 0 and fb > 0 then
                        out[#out + 1] = { a = a, b = b, level = lv, fa = fa, fb = fb }
                    end
                end
            end
        end
    end
    table.sort(out, function(x, y)
        if x.fa + x.fb ~= y.fa + y.fb then
            return x.fa + x.fb > y.fa + y.fb
        end
        return x.a .. x.b .. x.level < y.a .. y.b .. y.level
    end)
    return out
end

-- the side with the upper hand on a front, or nil while it's close
function leader(f)
    local total = f.fa + f.fb
    if f.fa >= UPPER * total then
        return f.a, f.b
    elseif f.fb >= UPPER * total then
        return f.b, f.a
    end
end

-- the fronts from a census; news where a side has newly taken the upper hand (none from the
-- first census after a load, which only sets where things stand), the biggest fronts first
local function take_fronts(c)
    FRONTS = fronts(c)
    COUNTED = true
    local now, said = {}, 0
    for _, f in ipairs(FRONTS) do
        local key = f.a .. "|" .. f.b .. "|" .. f.level
        local win, lose = leader(f)
        now[key] = win or false
        -- only a front that was there last time: fronts come and go as squads move
        local was = upper and upper[key]
        if was ~= nil and win and was ~= win and f.fa + f.fb >= FRONT_MIN and said < NEWS_PER_DAY then
            local P = fotz_politics
            if P and P.say and P.say("all", "st_fotz_news_front_upper", win,
                { b = P.faction_name(lose), place = game.translate_string(f.level) }) then
                said = said + 1
            end
        end
    end
    upper = now
end

-- your faction's footprint --------------------------------------------------------------------

-- the most your footprint raises a score: MCM's slider (percent), else the config's
function footprint_cap()
    local v = ui_mcm and tonumber(ui_mcm.get("fotz/footprint_max"))
    if v then
        return math.max(0, v / 100)
    end
    return cfg.footprint
end

-- the pull, from a census's levels and your members now; returns how many levels draw someone
function footprint(c)
    FOOT = {}
    local F = fotz_faction and fotz_faction.F
    local P = fotz_perks
    local cap = footprint_cap()
    if not (F and c and type(c.factions) == "table" and P and P.member_level and cap > 0) then
        return 0
    end
    local list = {}
    for id, m in pairs(F.members) do
        -- no level: their server object is gone (dead, or released)
        local lv = not m.dead and P.member_level(id)
        if lv then
            list[#list + 1] = { lv = lv, w = P.weight_of(id),
                                mother = type(m.mother) == "string" and string.gsub(m.mother, "^actor_", "") or nil }
        end
    end
    if #list == 0 then
        return 0
    end
    local own = fotz_politics and fotz_politics.OWN or "fotz_own"
    local rel = relation_registry.community_relation
    -- every level the census knows
    local levels = {}
    for lv in pairs(c.levels or {}) do
        levels[lv] = true
    end
    for _, fe in pairs(c.factions) do
        for lv in pairs(type(fe) == "table" and fe.levels or {}) do
            levels[lv] = true
        end
    end
    local n = 0
    for _, e in ipairs(fotz_census.FACTIONS) do
        local fe = c.factions[e]
        local present = {}
        for lv, l in pairs(fe and fe.levels or {}) do
            if (l.fighters or 0) > 0 then
                present[#present + 1] = lv
            end
        end
        local hates_you = rel(e, own) <= ENEMIES
        for lv in pairs(#present > 0 and levels or {}) do
            -- its squads there, or next door
            local reach = false
            for _, at in ipairs(present) do
                if at == lv or P.nearness(at, lv) >= cfg.reach then
                    reach = true
                    break
                end
            end
            local draw = 0
            for _, m in ipairs(reach and list or {}) do
                if hates_you or (m.mother and rel(e, m.mother) <= ENEMIES) then
                    draw = draw + m.w * P.nearness(m.lv, lv)
                end
            end
            if draw > 0 then
                FOOT[e] = FOOT[e] or {}
                FOOT[e][lv] = 1 + cap * P.share(draw)
                n = n + 1
            end
        end
    end
    return n
end

-- the factions your footprint draws to the level you're on, the strongest first
function drawn_here()
    local out = {}
    if not on then
        return out
    end
    local here = level.name()
    for e, t in pairs(FOOT) do
        if t[here] and t[here] >= 1.005 then
            out[#out + 1] = { f = e, m = t[here] }
        end
    end
    table.sort(out, function(a, b) return a.m > b.m end)
    return out
end

-- a target's level, if it's a smart
local function level_of_target(target)
    local lv = smart_level[target.id]
    if lv == nil then
        lv = SIMBOARD and SIMBOARD.smarts and SIMBOARD.smarts[target.id] and fotz_census.level_of(target) or false
        smart_level[target.id] = lv
    end
    return lv
end

-- the wrapper: three table reads for a squad the steer and the footprint have nothing for
local function steered(target, squad, ...)
    local prior = orig(target, squad, ...)
    if not on then
        return prior
    end
    STATS.calls = STATS.calls + 1
    local t = STEER[squad.player_id]
    local m = t and t[target.id]
    local ft = FOOT[squad.player_id]
    local fm = ft and ft[level_of_target(target)]
    if (m == nil and fm == nil) or left_alone(squad) then
        return prior
    end
    if m and m > 1 then
        STATS.raised = STATS.raised + 1
    elseif m then
        STATS.lowered = STATS.lowered + 1
    end
    if fm then
        STATS.drawn = STATS.drawn + 1
    end
    return prior * (m or 1) * (fm or 1)
end

function install()
    if not (simulation_objects and type(simulation_objects.evaluate_prior) == "function") then
        log("! no simulation_objects.evaluate_prior: no steer")
        return false
    end
    -- still in place, or still inside a wrapper another mod put over ours: wrapping again would
    -- weigh twice
    if wrapper then
        return true
    end
    orig = simulation_objects.evaluate_prior
    wrapper = steered
    simulation_objects.evaluate_prior = wrapper
    return true
end

-- the original put back, but only if ours is still the one in place: a mod that wrapped over it
-- keeps its wrapper, and ours passes everything through while the steer is off
function uninstall()
    if wrapper and simulation_objects and simulation_objects.evaluate_prior == wrapper then
        simulation_objects.evaluate_prior = orig
        wrapper = nil
        return true
    end
    return false
end

-- on unless MCM turns it off, or Warfare mode runs the squads (not _G.WARFARE, which the base
-- warfare.script sets true as the game starts whatever the mode)
function enabled()
    if ui_mcm and ui_mcm.get("fotz/territory") == false then
        return false
    end
    return not (IsWarfare and IsWarfare())
end

-- the switch: in place and steering, or out of the way
function refresh()
    on = enabled()
    if on then
        on = install()
    else
        uninstall()
    end
    return on
end

local function on_census(c)
    refresh()
    local ok, err = pcall(take_fronts, c)
    if not ok then
        log("! fronts: %s", tostring(err))
    end
    -- the fronts on the PDA map, from the same census
    if fotz_map and fotz_map.update then
        ok, err = pcall(fotz_map.update, c)
        if not ok then
            log("! the map: %s", tostring(err))
        end
    end
    local n = rebuild(c)
    local factions = 0
    for _ in pairs(STEER) do
        factions = factions + 1
    end
    last_census = c
    INFLUENCE = influence(c)
    local ok2, drawn = pcall(footprint, c)
    if not ok2 then
        log("! the footprint: %s", tostring(drawn))
        drawn = 0
    end
    log("%s: %s fronts; %s smarts weighed for %s factions (%s); your footprint draws on %s levels; since the last census %s scores, %s raised, %s lowered, %s drawn",
        tostring(c and c.date), #FRONTS, n, factions, on and "steering" or "off", drawn, STATS.calls, STATS.raised,
        STATS.lowered, STATS.drawn)
    STATS.calls, STATS.raised, STATS.lowered, STATS.drawn = 0, 0, 0, 0
end

-- consequences ---------------------------------------------------------------------------------

local function strip(comm)
    return type(comm) == "string" and (string.gsub(comm, "^actor_", "")) or nil
end

-- an MCM slider's value, else the config's
local function slider(id, default)
    local v = ui_mcm and tonumber(ui_mcm.get("fotz/" .. id))
    return v and math.max(0, v) or default
end

-- the census's factions, as a set
local function factions()
    if not is_faction then
        is_faction = {}
        for _, f in ipairs(fotz_census.FACTIONS) do
            is_faction[f] = true
        end
    end
    return is_faction
end

-- each level's ground: level -> faction -> its share of the level's smarts
function influence(c)
    local is = factions()
    local out = {}
    for lv, l in pairs(c and c.levels or {}) do
        local n = l.smarts or 0
        for f, k in pairs(n > 0 and l.held or {}) do
            if is[f] then
                out[lv] = out[lv] or {}
                out[lv][f] = k / n
            end
        end
    end
    return out
end

-- a level's ground: the last census's; before the first census after a load (a level change is
-- one), the level's own, counted once on demand
local function ground(lv)
    local t = INFLUENCE[lv]
    if t == nil and not last_census and fotz_census.level_ground then
        local ok, l = pcall(fotz_census.level_ground, lv)
        if not ok then
            log("! the ground on %s: %s", lv, tostring(l))
        end
        t = ok and influence({ levels = { [lv] = l } })[lv] or {}
        INFLUENCE[lv] = t
    end
    return t or {}
end

-- your members settled on each level, with their steps and the faction they came from: not the
-- dead, nor your companions (they go where you go)
local function members_by_level()
    local FF, P = fotz_faction, fotz_perks
    local F = FF and FF.F
    if not (F and P and P.member_level) then
        return nil
    end
    local out = {}
    for id, m in pairs(F.members) do
        local lv = not m.dead and m.via ~= "companion" and not (FF.is_companion and FF.is_companion(id))
                   and P.member_level(id)
        if lv then
            out[lv] = out[lv] or {}
            table.insert(out[lv], { w = P.weight_of(id), mother = strip(m.mother) })
        end
    end
    return out
end

-- whether politics moves your faction's pair with f: not a faction whose relations never change,
-- nor one your old faction's are fixed with
local function has_pair(f)
    local P = fotz_politics
    return P ~= nil and P.pair_of ~= nil and P.pair_of(P.OWN, f) ~= nil
end

-- the steps of your members on a level who didn't come from f
local function outsiders(list, f)
    local n = 0
    for _, m in ipairs(list or {}) do
        if m.mother ~= f then
            n = n + m.w
        end
    end
    return n
end

-- the day's strain of your members settled on other factions' ground: faction -> the push on your
-- faction's pair with it (below 0), at most the cap
function encroachment(c)
    local out = {}
    local cap = slider("encroach_max", cfg.encroach)
    local by_level = cap > 0 and members_by_level()
    if not by_level then
        return out
    end
    local own = fotz_politics and fotz_politics.OWN or "fotz_own"
    local rel = relation_registry.community_relation
    for lv, shares in pairs(influence(c)) do
        for f, s in pairs(shares) do
            local n = by_level[lv] and outsiders(by_level[lv], f) or 0
            if n > 0 and rel(f, own) < FRIENDS and has_pair(f) then
                out[f] = (out[f] or 0) - cap * fotz_perks.share(n) * s
            end
        end
    end
    for f, v in pairs(out) do
        out[f] = math.max(-cap, v)
    end
    return out
end

-- the factions your members strain where you are, by the ground there; none while politics
-- stands down, which applies no strain
function strained_here()
    local out = {}
    local P = fotz_politics
    if P and P.standing_down and P.standing_down() then
        return out
    end
    local here = level.name()
    local by_level = members_by_level()
    local own = P and P.OWN or "fotz_own"
    if not (by_level and by_level[here] and slider("encroach_max", cfg.encroach) > 0) then
        return out
    end
    for f, s in pairs(ground(here)) do
        if outsiders(by_level[here], f) > 0 and relation_registry.community_relation(f, own) < FRIENDS
                and has_pair(f) then
            out[#out + 1] = { f = f, s = s }
        end
    end
    table.sort(out, function(a, b) return a.s > b.s end)
    return out
end

-- a stalker you kill on a faction's ground costs you some of its goodwill, unless it's at war with
-- the victim's faction, or it's the victim's own; only a faction's stalker (not an arena fighter,
-- a zombie or one of yours)
function instigated(victim_comm, lv)
    local F = fotz_faction and fotz_faction.F
    local per = slider("instigate_max", cfg.instigate)
    local v, n = strip(victim_comm), 0
    if not (F and per > 0 and factions()[v]) then
        return 0
    end
    local rel = relation_registry.community_relation
    for f, s in pairs(ground(lv)) do
        if f ~= v and rel(f, v) > ENEMIES then
            local loss = math.floor(per * s + 0.5)
            if loss > 0 then
                relation_registry.change_community_goodwill(f, AC_ID, -loss)
                log("you killed a %s on %s's ground (%s): %s goodwill", v, f, lv, -loss)
                n = n + 1
            end
        end
    end
    return n
end

local function npc_on_death_callback(victim, killer)
    if not (victim and killer and IsStalker(victim)) then
        return
    end
    local yours = killer:id() == AC_ID
    if not yours and not IsStalker(killer) then
        local owner = killer.parent and killer:parent()
        yours = owner ~= nil and owner:id() == AC_ID
    end
    -- one of your members (still in their old faction until they're next online, after a load)
    local F = fotz_faction and fotz_faction.F
    if yours and not (F and F.members[victim:id()]) then
        local ok, err = pcall(instigated, victim:character_community(), level.name())
        if not ok then
            log("! a kill's consequence: %s", tostring(err))
        end
    end
end

-- the footprint again now, from the last census: members came, went or moved
function update_footprint()
    if not last_census then
        return 0
    end
    local ok, n = pcall(footprint, last_census)
    if not ok then
        log("! the footprint: %s", tostring(n))
        return 0
    end
    return n
end

-- and every FOOT_MS, as members join, leave and move between censuses
local function actor_on_update()
    local now = time_global()
    if now < next_foot or not last_census then
        return
    end
    next_foot = now + FOOT_MS
    update_footprint()
end

function on_game_start()
    load_config()
    refresh()
    fotz_census.listen(on_census)
    RegisterScriptCallback("on_option_change", refresh)
    RegisterScriptCallback("actor_on_update", actor_on_update)
    RegisterScriptCallback("npc_on_death_callback", npc_on_death_callback)
end
