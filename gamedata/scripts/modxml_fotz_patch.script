--[[
Factions of the Zone: DXML, your faction's patches on the traders (fotz_patch). The dialog goes
into the game's dialogs; the line that offers it is added to the talk of the traders TRADERS
names (their specific characters) as their dialog lists are built, not in their character files,
so they have it whichever mod's copies of those files win. As Arsenal adds its own talks.

Who sews them: Sidorovich, and every faction's own traders at the bases its players can start
from, so whatever faction you came from, one of them will talk to you. The Renegades have no
trader; the Bandits', who are friendly to them, take their orders.

The trader asks how many; each count shows only when you can pay for it, and after each the trader
asks again, so you buy as many as you like.
--]]

DIALOG = "fotz_patch_order"

-- each faction's traders: their specific characters, named by their story ids
TRADERS = {
    stalker  = { "esc_2_12_stalker_trader",                       -- Sidorovich, Cordon
                 "zat_b30_owl_stalker_trader" },                  -- Owl, Zaton
    army     = { "agr_smart_terrain_1_6_army_trader_stalker",     -- Sergeant Spooner, Agroprom
                 "esc_3_16_military_trader" },                    -- Major Zhurov, Cordon
    bandit   = { "val_smart_terrain_7_4_bandit_trader_stalker",   -- Olivius, Dark Valley
                 "jup_cont_trader_bandit",                        -- Klenov, Jupiter
                 "trucks_cemetery_bandit_trader" },               -- Truck Cemetery
    csky     = { "mar_base_owl_stalker_trader" },                 -- Spore, Great Swamps
    dolg     = { "bar_dolg_general_petrenko_stalker" },           -- Colonel Petrenko, Rostok
    ecolog   = { "yan_stalker_sakharov",                          -- Professor Sakharov, Yantar
                 "jup_b6_scientist_nuclear_physicist" },          -- Professor Hermann, Jupiter
    freedom  = { "mil_smart_terrain_7_10_freedom_trader_stalker", -- Skinflint, Army Warehouses
                 "jup_a6_freedom_trader_ashot" },                 -- Ashot, Jupiter
    killer   = { "cit_killers_merc_trader_stalker",               -- Dushman, Dead City
                 "zat_stancia_trader_merc",                       -- Vector, Zaton
                 "pri_special_trader_mlr" },                      -- Meeker, Pripyat
    monolith = { "pri_monolith_monolith_trader_stalker",          -- Krolik, Pripyat
                 "trader_monolith_kbo",                           -- Olivar, Pripyat
                 "trader_monolith_jup_depo" },                    -- the Jupiter depot
    greh     = { "red_greh_trader" },                             -- Stribog, Red Forest
    isg      = { "jup_depo_isg_leader" },                         -- Major Hernandez, Jupiter
}

local sews = {}
for _, ids in pairs(TRADERS) do
    for _, id in ipairs(ids) do
        sews[id] = true
    end
end

local function count(id, n)
    return [[
        <phrase id="]] .. id .. [[">
            <precondition>fotz_patch.can_buy_]] .. n .. [[</precondition>
            <script_text>fotz_patch.text_]] .. n .. [[</script_text>
            <action>fotz_patch.buy_]] .. n .. [[</action>
            <next>2</next>
        </phrase>]]
end

local CHOICES = [[
            <next>11</next>
            <next>12</next>
            <next>13</next>
            <next>14</next>
            <next>19</next>]]

XML = [[
<dialog id="]] .. DIALOG .. [[">
    <precondition>fotz_patch.leading</precondition>
    <phrase_list>
        <phrase id="0">
            <text>st_fotz_patch_ask</text>
            <next>1</next>
        </phrase>
        <phrase id="1">
            <script_text>fotz_patch.offer_text</script_text>]] .. CHOICES .. [[
        </phrase>]] .. count(11, 1) .. count(12, 5) .. count(13, 10) .. count(14, 20) .. [[
        <phrase id="19">
            <text>st_fotz_patch_not_now</text>
        </phrase>
        <phrase id="2">
            <text>st_fotz_patch_done</text>]] .. CHOICES .. [[
        </phrase>
    </phrase_list>
</dialog>
]]

local said = {}

local function guarded(what, fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok and not said[tostring(err)] then
        said[tostring(err)] = true
        printf("[fotz-patch] %s: %s", what, tostring(err))
    end
end

-- the dialog, once, in the game's dialogs
function edit(name, xml)
    if name ~= [[gameplay\dialogs.xml]] and name ~= [[gameplay/dialogs.xml]] then
        return false
    end
    if #xml:query("dialog[id=" .. DIALOG .. "]") > 0 then
        return false
    end
    xml:insertFromXMLString(XML)
    return true
end

-- the line in each trader's talk, once
function add_talk(character_id, list)
    if not sews[character_id] or list:has(DIALOG) then
        return false
    end
    list:add(DIALOG)
    return true
end

function on_xml_read()
    RegisterScriptCallback("on_xml_read", function(name, xml)
        guarded("DXML " .. tostring(name), edit, name, xml)
    end)
end

function on_game_start()
    RegisterScriptCallback("on_specific_character_dialog_list", function(character_id, list)
        guarded("a trader's talk", add_talk, character_id, list)
    end)
end
