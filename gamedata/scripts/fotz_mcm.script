--[[
Factions of the Zone: its MCM page. Options are read with ui_mcm.get("fotz/<id>").

The faction options belong to the save you're playing: fotz_faction sets them from the save at
each load, and changing them founds, renames or disbands that save's faction. Two switches act once
and set themselves back: "Reset relations to a new game's" (fotz_tab) and "Remove your faction's
patches" (fotz_patch).
--]]

function on_mcm_load()
    local page = {
        id = "fotz",
        sh = true,
        gr = {
            { id = "title", type = "slide", link = "ui_options_slider_player", text = "ui_mcm_menu_fotz",
              size = { 512, 50 }, spacing = 20 },
            { id = "faction", type = "check", val = 1, def = false },
            { id = "faction_name", type = "input", val = 0, def = "" },
            { id = "faction_join", type = "check", val = 1, def = false },
            { id = "faction_companions", type = "check", val = 1, def = true },
            -- with Homestead: your residents earn loyalty and ask to join (fotz_loyalty)
            { id = "loyalty", type = "check", val = 1, def = true },
            { id = "loyalty_accept", type = "check", val = 1, def = false },
            -- with Homestead: a rival outpost you beat may surrender or come over (fotz_outposts)
            { id = "outposts", type = "check", val = 1, def = true },
            -- a member from a faction brings a small perk of its own (fotz_perks)
            { id = "perks", type = "check", val = 1, def = true },
            -- the perks' caps, in percent or points out of 100 (the [perks] *_max defaults)
            { id = "perks_trade_max", type = "track", val = 2, min = 0, max = 25, step = 1, def = 15 },
            { id = "perks_airlift_max", type = "track", val = 2, min = 0, max = 40, step = 1, def = 30 },
            { id = "perks_merc_max", type = "track", val = 2, min = 0, max = 100, step = 5, def = 100 },
            { id = "perks_outpost_max", type = "track", val = 2, min = 0, max = 25, step = 1, def = 15 },
            { id = "perks_relations_max", type = "track", val = 2, min = 0, max = 200, step = 10, def = 100 },
            { id = "line1", type = "line" },
            { id = "politics", type = "check", val = 1, def = true },
            { id = "territory", type = "check", val = 1, def = true },
            -- your faction's footprint draws squads hostile to your members (fotz_territory), in percent
            { id = "footprint_max", type = "track", val = 2, min = 0, max = 100, step = 5, def = 50 },
            -- consequences on other factions' ground (fotz_territory): a day's strain, a kill's goodwill
            { id = "encroach_max", type = "track", val = 2, min = 0, max = 100, step = 5, def = 40 },
            { id = "instigate_max", type = "track", val = 2, min = 0, max = 50, step = 1, def = 15 },
            { id = "map", type = "check", val = 1, def = true },
            { id = "news", type = "list", val = 0, def = "events", content = {
                { "off", "fotz_news_off" },
                { "events", "fotz_news_events" },
                { "all", "fotz_news_all" },
            } },
            { id = "census", type = "check", val = 1, def = true },
            -- once, in a loaded game: every relation back to a new game's (fotz_tab), its warning shown
            { id = "reset_relations_warn", type = "desc", text = "ui_mcm_fotz_reset_relations_warn", clr = { 255, 238, 196, 112 } },
            { id = "reset_relations", type = "check", val = 1, def = false },
            -- before removing the mod: every patch of your faction out of the game (fotz_patch)
            { id = "remove_patches", type = "check", val = 1, def = false },
            { id = "tab_key", type = "key_bind", val = 2, def = -1 },
            { id = "about", type = "desc", text = "ui_mcm_fotz_about" },
        },
    }
    -- with Mod App Creator, the page opens from its tile unless this asks for its own tab; without
    -- MAC it always has the tab, so the option isn't there
    if z_fotz_mac and z_fotz_mac.available() then
        table.insert(page.gr, #page.gr, { id = "pda_tab", type = "check", val = 1, def = false })
    end
    return page
end
