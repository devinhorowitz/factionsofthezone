--[[
Factions of the Zone: the Factions page, as the PDA's tab and as a window of its own.

It lays out fotz_tab.page() and nothing else, the way Seasons' and Arsenal's pages are laid out:
a chamfered frame with its corners left open; the header (your side's icon, name and a line on
it, and at its right Back while the page came from Mod App Creator's tile); under it a button for
each subpage, Relations, Fighting, Members (while you lead a faction) and War log, the one shown
with its label in amber and a line under it; the subpage, in a scroll view; and the footer: whether
politics is in charge, the PDA's own Relations tab (from the PDA only) and the credit. The page
shows the subpage last chosen (fotz_tab.choose).

A subpage is built anew at each fill into one box, which then goes into the scroll view: a scroll
view measures what it holds when a window is added, never when one is resized. Rows and lines are
ui_fotz_tab.xml's templates, placed one under another, every wrapped line by its real height. A
fill frees the last box with everything in it, so Accept and Decline, which sit in it, act at once
and leave the fill to the next update: filling during the click would free the button clicked. A
refill of the same subpage keeps it scrolled where it was.

The art is the game's own (the faction icons, ui_mm_faction_<faction>; the button and the 2D
PDA's frame), so an HD pack that replaces them shows through, and nothing here can be missing;
the lines are this mod's one white pixel, tinted.

CScriptXmlInit:ParseFile does not raise when the file can't be used; every Init* after it gives
nil, and a method call on nil is an engine fatal. So no widget is used unchecked.
--]]

local SINGLETON = nil
local FLAT = nil
-- the PDA's pages sit this far into the screen (pda_16.xml), and so does the flat window
local PDA_X, PDA_Y = 112, 34
-- the subpages' buttons, from the left (each 160 wide, ui_fotz_tab.xml)
local SUBPAGE_X, SUBPAGE_STEP, MARK_Y = 52, 168, 204
-- within a subpage: a faction's row, a request's, the space under a line and between groups
local ROW_STEP, REQUEST_STEP, LINE_GAP, GROUP_GAP = 34, 26, 2, 8

-- The frame: a chamfered outline with its corners left open, a rule under the header and one
-- over the footer. Close to the background on purpose: they group things, they aren't there to be
-- looked at.
local RULE, RULE_A = { 74, 80, 74 }, 210
local FR_L, FR_T, FR_R, FR_B = 38, 112, 782, 700
local CHAMFER = 14
local HEAD_Y, FOOT_Y = 168, 632
local AMBER, LABEL, FIXED = { 238, 196, 112 }, { 220, 220, 220 }, { 170, 170, 170 }

local function say(msg)
    printf("[fotz-tab] %s", tostring(msg))
end

local function put(w, s)
    if w then
        w:SetText(s or "")
    end
end

local function show(w, on)
    if w then
        w:Show(on)
    end
end

-- `s` cut to `n` letters with an ellipsis (133 in windows-1251), for a line narrower than a name
local function fit(s, n)
    s = tostring(s or "")
    if #s <= n then
        return s
    end
    return s:sub(1, n - 1) .. "\133"
end

-- InitTexture doesn't apply width_factor: a square icon needs its width scaled by 4:3 over the
-- screen's aspect
local function aspect()
    local ok, w, h = pcall(function() return device().width, device().height end)
    if ok and w and h and h > 0 then
        return (1024 / 768) / (w / h)
    end
    return 0.75
end

local function square(w)
    if w then
        local h = w:GetHeight()
        w:SetWndSize(vector2():set(h * aspect(), h))
    end
end

-- an icon drawn at its own proportions: its width scaled the same way
local function narrow(w)
    if w then
        w:SetWndSize(vector2():set(w:GetWidth() * aspect(), w:GetHeight()))
    end
end

local TREND = {
    up = { "ui_inGame2_arrow_up", 140, 205, 130 },
    down = { "ui_inGame2_arrow_down", 230, 80, 70 },
}

local function moved(w, x, y)
    if w then
        w:SetWndPos(vector2():set(x, y))
    end
    return w
end

local function tint(w, rgb)
    if w and rgb then
        w:SetTextColor(GetARGB(255, rgb[1], rgb[2], rgb[3]))
    end
end

-- a rule of the frame's color, x, y, w, h, on `parent`
local function rule(xml, parent, x, y, w, h)
    local s = xml:InitStatic("px", parent)
    if s then
        s:SetWndPos(vector2():set(x, y))
        s:SetWndSize(vector2():set(w, h))
        s:SetTextureColor(GetARGB(RULE_A, RULE[1], RULE[2], RULE[3]))
    end
    return s
end

-- a wrapped line in the box at y, tinted, as tall as its text; the y under it
local function para(xml, box, y, s, rgb)
    local w = xml:InitTextWnd("line", box)
    if not w then
        return y
    end
    w:SetText(s or "")
    tint(w, rgb)
    w:AdjustHeightToText()
    moved(w, w:GetWndPos().x, y)
    return y + w:GetHeight()
end

class "FactionsTab" (CUIScriptWnd)

function FactionsTab:__init(flat) super()
    self.flat = flat == true
    self.answers = {}       -- the request buttons' names with a callback
    self.request_ids = {}
    self:InitControls()
end

function FactionsTab:__finalize()
    if self.flat then
        FLAT = nil
    else
        SINGLETON = nil
    end
end

-- the frame's lines, made once: the frame never moves
function FactionsTab:InitFrame()
    local xml = self.xml
    local inner = FR_R - FR_L - CHAMFER * 2
    rule(xml, self, FR_L + CHAMFER, FR_T, inner, 1)
    rule(xml, self, FR_L + CHAMFER, FR_B, inner, 1)
    rule(xml, self, FR_L, FR_T + CHAMFER, 1, FR_B - FR_T - CHAMFER * 2)
    rule(xml, self, FR_R, FR_T + CHAMFER, 1, FR_B - FR_T - CHAMFER * 2)
    rule(xml, self, FR_L + CHAMFER, HEAD_Y, inner, 1)
    rule(xml, self, FR_L + CHAMFER, FOOT_Y, inner, 1)
end

function FactionsTab:InitControls()
    local x, y = self.flat and PDA_X or 0, self.flat and PDA_Y or 0
    self:SetWndRect(Frect():set(x, y, x + 1024, y + 768))
    local xml = CScriptXmlInit()
    xml:ParseFile("ui_fotz_tab.xml")
    self.xml = xml
    if self.flat then
        xml:InitStatic("flat_bezel", self)
        put(xml:InitTextWnd("flat_caption", self), fotz_tab.text("st_fotz_tab"))
    end
    if not xml:InitStatic("background", self) then
        say("ui_fotz_tab.xml gave no elements: check the file")
        return
    end
    self:InitFrame()
    self.icon = xml:InitStatic("icon", self)
    square(self.icon)
    self.title = xml:InitTextWnd("title", self)
    self.subtitle = xml:InitTextWnd("subtitle", self)

    -- the subpages' buttons, placed in Fill; each label after its plate, so it draws on top
    self.subpages = {}
    for _, s in ipairs(fotz_tab.SUBPAGES) do
        local b = { button = xml:Init3tButton("subpage", self), label = xml:InitTextWnd("subpage_label", self) }
        if b.button then
            local name = "subpage_" .. s
            self:Register(b.button, name)
            self:AddCallback(name, ui_events.BUTTON_CLICKED, function() self:OnSubpage(s) end, self)
        end
        self.subpages[s] = b
    end
    -- the line under the subpage shown
    self.mark = xml:InitStatic("px", self)
    if self.mark then
        self.mark:SetWndSize(vector2():set(160, 2))
        self.mark:SetTextureColor(GetARGB(255, AMBER[1], AMBER[2], AMBER[3]))
    end
    self.view = xml:InitScrollView("view", self)

    -- Back, in the header; each label after its plate, so it draws on top
    self.back = xml:Init3tButton("back", self)
    self.back_label = xml:InitTextWnd("back_label", self)
    put(self.back_label, fotz_tab.text("st_fotz_tab_back"))
    if self.back then
        self:Register(self.back, "back")
        self:AddCallback("back", ui_events.BUTTON_CLICKED, self.OnBack, self)
    end

    -- the footer
    self.status = xml:InitTextWnd("status", self)
    self.numbers = xml:Init3tButton("numbers", self)
    self.numbers_label = xml:InitTextWnd("numbers_label", self)
    put(self.numbers_label, fotz_tab.text("st_fotz_tab_numbers"))
    if self.numbers then
        self:Register(self.numbers, "numbers")
        self:AddCallback("numbers", ui_events.BUTTON_CLICKED, self.OnNumbers, self)
    end
    self.credit = xml:InitTextWnd("credit", self)
end

-- the numbers: the PDA's own Relations tab
function FactionsTab:OnNumbers()
    local ok, err = pcall(fotz_tab.to_relations)
    if not ok then
        say("! the Relations tab: " .. tostring(err))
    end
end

-- Back to MAC's launcher, the way MAC's own key goes
function FactionsTab:OnBack()
    local m = ActorMenu.get_pda_menu()
    if m then
        m:SetActiveSubdialog("eptLauncher")
    end
end

-- a subpage's button: that subpage, from its top (the button isn't in the box, so the page can be
-- filled at once)
function FactionsTab:OnSubpage(s)
    fotz_tab.choose(s)
    self:Reset()
end

-- a faction's row in the box at y
function FactionsTab:Row(box, y, row)
    local xml = self.xml
    local r = {
        icon = xml:InitStatic("row_icon", box),
        name = xml:InitTextWnd("row_name", box),
        trend = xml:InitStatic("row_trend", box),
        standing = xml:InitTextWnd("row_standing", box),
        change = xml:InitTextWnd("row_change", box),
        detail = xml:InitTextWnd("row_detail", box),
        event = xml:InitTextWnd("row_event", box),
    }
    square(r.icon)
    narrow(r.trend)
    for _, w in pairs(r) do
        moved(w, w:GetWndPos().x, y + w:GetWndPos().y)
    end
    if r.icon then
        r.icon:InitTexture(row.icon)
    end
    put(r.name, row.name)
    put(r.standing, row.standing)
    tint(r.standing, row.color)
    put(r.change, row.change)
    put(r.detail, fit(row.detail, 30))
    put(r.event, row.event)
    local t = TREND[row.trend]
    show(r.trend, t ~= nil)
    if t and r.trend then
        r.trend:InitTexture(t[1])
        r.trend:SetTextureColor(GetARGB(255, t[2], t[3], t[4]))
    end
end

-- a join request in the box at y, its line and Accept and Decline; the y under it. The buttons are
-- named by their row, and a name's callback is added once (it would replace itself anyway)
function FactionsTab:Request(box, y, i, q)
    local xml = self.xml
    local r = {
        line = xml:InitTextWnd("request_line", box),
        accept = xml:Init3tButton("request_accept", box),
        accept_label = xml:InitTextWnd("request_accept_label", box),
        decline = xml:Init3tButton("request_decline", box),
        decline_label = xml:InitTextWnd("request_decline_label", box),
    }
    put(r.line, q.line)
    put(r.accept_label, fotz_tab.text("st_fotz_tab_accept"))
    put(r.decline_label, fotz_tab.text("st_fotz_tab_decline"))
    if r.line then
        r.line:AdjustHeightToText()
    end
    for _, w in pairs(r) do
        moved(w, w:GetWndPos().x, y + w:GetWndPos().y)
    end
    for _, what in ipairs({ "accept", "decline" }) do
        if r[what] then
            local name = what .. i
            self:Register(r[what], name)
            if not self.answers[name] then
                self.answers[name] = true
                self:AddCallback(name, ui_events.BUTTON_CLICKED, function() self:OnAnswer(i, what) end, self)
            end
        end
    end
    self.request_ids[i] = q.id
    return y + math.max(REQUEST_STEP, (r.line and r.line:GetHeight() or 0) + 8)
end

-- the subpages, each built into the box; each gives the box's height

-- the rows, the factions that never change under a rule, then the perks your members bring, what
-- your footprint draws here and whom settling here strains, a sentence each
function FactionsTab:Relations(box, p)
    local xml, y = self.xml, 0
    for _, row in ipairs(p.rows) do
        self:Row(box, y, row)
        y = y + ROW_STEP
    end
    if #p.rows > 0 and #p.fixed > 0 then
        rule(xml, box, 0, y + 2, box:GetWidth(), 1)
        y = y + 10
    end
    for _, s in ipairs(p.fixed) do
        y = para(xml, box, y, s, FIXED) + GROUP_GAP
    end
    local W = fotz_tab.WARN
    for _, it in ipairs({ { p.perks, fotz_tab.COLORS.friends }, { p.drawn, W }, { p.strains, W } }) do
        if it[1] then
            y = para(xml, box, y, it[1], it[2]) + GROUP_GAP
        end
    end
    return y
end

function FactionsTab:Fighting(box, p)
    local y = 0
    for _, s in ipairs(p.fights) do
        y = para(self.xml, box, y, s) + GROUP_GAP
    end
    return y
end

-- the requests, each with its buttons; then the members; then the residents nearest to asking,
-- each group under a rule
function FactionsTab:Members(box, p)
    local xml, y = self.xml, 0
    for i, q in ipairs(p.requests or {}) do
        y = self:Request(box, y, i, q)
    end
    for _, group in ipairs({ p.members or {}, p.residents or {} }) do
        if #group > 0 and y > 0 then
            rule(xml, box, 0, y + 2, box:GetWidth(), 1)
            y = y + 10
        end
        for _, s in ipairs(group) do
            y = para(xml, box, y, s) + LINE_GAP
        end
    end
    return y
end

function FactionsTab:Log(box, p)
    local y = 0
    for _, s in ipairs(p.log) do
        y = para(self.xml, box, y, s) + LINE_GAP
    end
    return y
end

local BUILD = { relations = "Relations", fighting = "Fighting", members = "Members", log = "Log" }

-- the subpage shown, built anew into the scroll view; the same subpage again stays scrolled where it
-- was (at the next update, once the view has measured the box)
function FactionsTab:FillView(p)
    if not self.view then
        return
    end
    local keep = self.on_subpage == p.subpage and self.view:GetCurrentScrollPos() or nil
    self.request_ids = {}
    self.view:Clear()
    local box = self.xml:InitStatic("box", nil)
    if not box then
        return
    end
    local ok, h = pcall(self[BUILD[p.subpage]], self, box, p)
    if not ok then
        say("! the subpage " .. tostring(p.subpage) .. ": " .. tostring(h))
        h = 0
    end
    box:SetWndSize(vector2():set(box:GetWidth(), math.max(1, h)))
    self.view:AddWindow(box, true)
    self.on_subpage, self.scroll_to = p.subpage, keep
end

function FactionsTab:Fill()
    local p = fotz_tab.page()
    if self.icon then
        self.icon:InitTexture(p.icon)
    end
    put(self.title, fit(p.title, 40))
    put(self.subtitle, p.subtitle)
    put(self.status, p.status)
    -- the subpages' buttons, left to right, the one shown in amber with the line under it
    local has = {}
    for _, s in ipairs(p.subpages) do
        has[s] = true
    end
    local x = SUBPAGE_X
    for _, s in ipairs(fotz_tab.SUBPAGES) do
        local b = self.subpages and self.subpages[s]
        if b then
            show(b.button, has[s] == true)
            show(b.label, has[s] == true)
            if has[s] then
                moved(b.button, x, b.button and b.button:GetWndPos().y or 0)
                moved(b.label, x, b.label and b.label:GetWndPos().y or 0)
                put(b.label, p.labels[s])
                tint(b.label, s == p.subpage and AMBER or LABEL)
                if s == p.subpage then
                    moved(self.mark, x, MARK_Y)
                end
                x = x + SUBPAGE_STEP
            end
        end
    end
    self:FillView(p)
    put(self.credit, p.credit)
    -- Back while the page came from MAC's tile; flat, or from its own tab, the way out is the PDA's.
    -- The Relations tab only in the PDA: flat, there's no PDA to switch
    local back = not self.flat and fotz_tab.back_to_launcher()
    show(self.back, back)
    show(self.back_label, back)
    show(self.numbers, not self.flat)
    show(self.numbers_label, not self.flat)
end

function FactionsTab:Reset()
    local ok, err = pcall(function() self:Fill() end)
    if not ok then
        say("! the page could not be filled: " .. tostring(err))
    end
end

-- a join request answered: the row's settler accepted or declined, and the page filled again at the
-- next update (the button clicked sits in the box a fill frees)
function FactionsTab:OnAnswer(i, what)
    local id = self.request_ids and self.request_ids[i]
    if id and fotz_loyalty then
        self.request_ids[i] = nil
        local ok, err = pcall(what == "accept" and fotz_loyalty.accept or fotz_loyalty.decline, id)
        if not ok then
            say("! the request: " .. tostring(err))
        end
    end
    self.refill = true
end

function FactionsTab:Update()
    CUIScriptWnd.Update(self)
    if self.refill then
        self.refill = nil
        self:Reset()
    elseif self.scroll_to and self.view then
        local pos = self.scroll_to
        self.scroll_to = nil
        self.view:SetScrollPos(math.max(0, pos))
    end
end

function FactionsTab:Close()
    if self:IsShown() then
        self:HideDialog()
    end
end

-- flat, Escape and the page's key close it; in the PDA, the keys are the PDA's
function FactionsTab:OnKeyboard(dik, action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, action)
    if res then
        return res
    end
    if self.flat and action == ui_events.WINDOW_KEY_PRESSED
        and (dik == DIK_keys.DIK_ESCAPE or dik == fotz_tab.key()) then
        self:Close()
        return true
    end
    return false
end

-- the page for the PDA's tab, filled afresh each time it's shown
function get_ui()
    SINGLETON = SINGLETON or FactionsTab()
    SINGLETON:Reset()
    return SINGLETON
end

function open_flat()
    FLAT = FLAT or FactionsTab(true)
    if not FLAT:IsShown() then
        FLAT:Reset()
        FLAT:ShowDialog(true)
    end
    return FLAT
end

function close_flat()
    if FLAT then
        FLAT:Close()
    end
end

function flat_window()
    return (FLAT and FLAT:IsShown()) and FLAT or nil
end
