# Brazilian Portuguese for Factions of the Zone's string tables, by cuph0332 (2026-11-17).
# msgctxt is the string id, msgid the English text it was translated from, msgstr the Portuguese.
# build_text.py writes gamedata/configs/text/ptb/ from this file and the English table, in
# windows-1252: ptb is the language GAMMA's Brazilian Portuguese pack sets. An id with no
# Portuguese yet, or whose English changed since it was translated, is left out of the table,
# and the game shows its English. Written without accents, so it reads in any font.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: pt_BR\n"

msgctxt "ui_mcm_menu_fotz"
msgid "Factions of the Zone"
msgstr "Factions of the Zone"

msgctxt "ui_mcm_fotz_politics"
msgid "Factions change their relations"
msgstr "As faccoes mudam suas relacoes"

msgctxt "ui_mcm_fotz_politics_desc"
msgid "Once a game day, kills, ground taken and fronts move the relations between factions, and wars, truces and alliances follow. Turned off, every faction goes back to the relations the game gave it."
msgstr "Uma vez por dia de jogo, mortes, territorio conquistado e frentes de batalha movem as relacoes entre as faccoes, e guerras, treguas e aliancas surgem dai. Se desativado, cada faccao volta as relacoes que o jogo lhe deu."

msgctxt "ui_mcm_fotz_territory"
msgid "Squads lean toward winning fronts"
msgstr "Esquadroes tendem a ir as frentes vencedoras"

msgctxt "ui_mcm_fotz_territory_desc"
msgid "A faction sends its squads toward ground its enemies hold where it outnumbers them on that level, and less often where it is outnumbered. Only a bias in the game's own choice of where squads go: no orders, no new squads. Off in Warfare mode, which runs the squads itself."
msgstr "Uma faccao envia seus esquadroes para o territorio que seus inimigos controlam quando esta em maior numero nesse nivel, e com menos frequencia quando esta em menor numero. E apenas uma inclinacao na escolha que o proprio jogo faz de para onde os esquadroes vao: sem ordens, sem novos esquadroes. Desativado no modo Warfare, que controla os esquadroes por conta propria."

msgctxt "ui_mcm_fotz_map"
msgid "Fronts on the PDA map"
msgstr "Frentes no mapa do PDA"

msgctxt "ui_mcm_fotz_map_desc"
msgid "A marker on each level where hostile factions fight, 10 fighters or more and at least 3 a side: red when the fight is your side's, amber otherwise, with the two sides named under it. Hover it to see who is winning and which factions there are hostile to you. The markers are never saved."
msgstr "Um marcador em cada nivel onde faccoes hostis lutam, com 10 combatentes ou mais e pelo menos 3 de cada lado: vermelho quando a luta e do seu lado, ambar nos demais casos, com os dois lados nomeados embaixo. Passe o mouse sobre ele para ver quem esta vencendo e quais faccoes ali sao hostis a voce. Os marcadores nunca sao salvos."

msgctxt "ui_mcm_fotz_news"
msgid "News on the PDA"
msgstr "Noticias no PDA"

msgctxt "ui_mcm_fotz_news_desc"
msgid "Factions announce wars, truces and alliances on the PDA. With Everything, they also report the ground they take."
msgstr "As faccoes anunciam guerras, treguas e aliancas no PDA. Com a opcao Tudo, tambem relatam o territorio que conquistam."

msgctxt "ui_mcm_lst_fotz_news_off"
msgid "Off"
msgstr "Desligado"

msgctxt "ui_mcm_lst_fotz_news_events"
msgid "Wars, truces and alliances"
msgstr "Guerras, treguas e aliancas"

msgctxt "ui_mcm_lst_fotz_news_all"
msgid "Everything"
msgstr "Tudo"

msgctxt "ui_mcm_fotz_census"
msgid "Keep a census"
msgstr "Manter um censo"

msgctxt "ui_mcm_fotz_census_desc"
msgid "Once a game day, and once after each load, count every faction's squads and the ground they hold, and write it to fotz_census.jsonl in the game's appdata folder. It changes nothing in the game."
msgstr "Uma vez por dia de jogo, e uma vez apos cada carregamento, conta os esquadroes de cada faccao e o territorio que elas controlam, e grava o resultado em fotz_census.jsonl na pasta appdata do jogo. Nao altera nada no jogo."

msgctxt "ui_mcm_fotz_about"
msgid "Relations change only between factions the base game lets change, within lore limits. Factions of the Zone steps aside while the base game's dynamic relations, Fluid Relations, Dynamic Faction Relations Customizer, or Warfare mode handle relations."
msgstr "As relacoes so mudam entre faccoes que o jogo base permite mudar, dentro dos limites do lore. Factions of the Zone fica de lado enquanto as relacoes dinamicas do jogo base, o Fluid Relations, o Dynamic Faction Relations Customizer ou o modo Warfare cuidam das relacoes."

msgctxt "st_fotz_news_war_kills"
msgid "Too many of ours have died at the hands of {b}. From today we are at war with them."
msgstr "Gente demais dos nossos morreu nas maos de {b}. A partir de hoje, estamos em guerra com eles."

msgctxt "st_fotz_news_war_ground"
msgid "{b} took {place} from us. From today we are at war with them."
msgstr "Perdemos {place} para {b}. A partir de hoje, estamos em guerra com eles."

msgctxt "st_fotz_news_war_front"
msgid "We have fought {b} at {place} for days. From today we are at war with them."
msgstr "Lutamos contra {b} em {place} por dias. A partir de hoje, estamos em guerra com eles."

msgctxt "st_fotz_news_war_settled"
msgid "{b} settled on our ground and stayed. From today we are at war with them."
msgstr "Nosso territorio foi ocupado por {b}, que veio para ficar. A partir de hoje, estamos em guerra com eles."

msgctxt "st_fotz_news_war_incident"
msgid "{b} crossed us once too often. From today we are at war with them."
msgstr "Chega das provocacoes de {b}. A partir de hoje, estamos em guerra com eles."

msgctxt "st_fotz_news_war_incident_at"
msgid "{b} crossed us at {place} once too often. From today we are at war with them."
msgstr "Chega das provocacoes de {b} em {place}. A partir de hoje, estamos em guerra com eles."

msgctxt "st_fotz_news_truce"
msgid "The line with {b} has gone quiet. We hold our fire, for now."
msgstr "A linha com {b} ficou quieta. Seguramos o fogo, por enquanto."

msgctxt "st_fotz_news_alliance"
msgid "We stand with {b} against {enemy}. Treat them as friends."
msgstr "Estamos ao lado de {b} contra {enemy}. Tratem-nos como amigos."

msgctxt "st_fotz_news_alliance_plain"
msgid "We are allies of {b} now. Treat them as friends."
msgstr "Agora somos aliados de {b}. Tratem-nos como amigos."

msgctxt "st_fotz_news_alliance_over"
msgid "Our alliance with {b} is over."
msgstr "Nossa alianca com {b} acabou."

msgctxt "st_fotz_news_ground"
msgid "We took {place} from {b}."
msgstr "Tomamos {place} de {b}."

msgctxt "st_fotz_news_front_upper"
msgid "In {place} the upper hand over {b} is ours now."
msgstr "Em {place}, agora a vantagem sobre {b} e nossa."

