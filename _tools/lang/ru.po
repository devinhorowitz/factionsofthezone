msgctxt "st_fotz_tab_yours"
msgid "Your faction · founded {date} · came from: {from} · members: {n}"
msgstr "Ваша группировка · основана {date} · прежняя: «{from}» · бойцов: {n}"

msgctxt "st_fotz_tab_no_faction"
msgid "You lead no faction of your own. Found one in MCM, under Factions of the Zone."
msgstr "У вас нет своей группировки. Её можно основать в MCM, в разделе «Фракции Зоны»."

msgctxt "st_fotz_tab_in_charge"
msgid "Relations change as the factions fight."
msgstr "Отношения меняются по ходу боёв между группировками."

