# Russian for Factions of the Zone's string tables.
# msgctxt is the string id, msgid the English text it was translated from, msgstr the Russian.
# build_text.py writes gamedata/configs/text/rus/ from this file and the English table, and
# refuses an id whose English has changed since it was translated (msgid differs) or that has
# no Russian yet. Term choices follow Seasons of the Zone's. A name filled into a sentence stays
# nominative, so it is framed: группировка «{b}», позиция «{place}».
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ru\n"

msgctxt "ui_mcm_menu_fotz"
msgid "Factions of the Zone"
msgstr "Фракции Зоны"

msgctxt "ui_mcm_fotz_politics"
msgid "Factions change their relations"
msgstr "Группировки меняют отношения"

msgctxt "ui_mcm_fotz_politics_desc"
msgid "Once a game day, kills, ground taken and fronts move the relations between factions, and wars, truces and alliances follow. Turned off, every faction goes back to the relations the game gave it."
msgstr "Раз в игровые сутки убийства, захваченные позиции и линии фронта меняют отношения между группировками, а за ними следуют войны, перемирия и союзы. Если выключить, каждая группировка вернётся к отношениям, заданным игрой."

msgctxt "ui_mcm_fotz_news"
msgid "News on the PDA"
msgstr "Новости в КПК"

msgctxt "ui_mcm_fotz_news_desc"
msgid "Factions announce wars, truces and alliances on the PDA. With Everything, they also report the ground they take."
msgstr "Группировки объявляют в КПК войны, перемирия и союзы. В режиме «Всё» они ещё сообщают о захваченных позициях."

msgctxt "ui_mcm_lst_fotz_news_off"
msgid "Off"
msgstr "Выкл."

msgctxt "ui_mcm_lst_fotz_news_events"
msgid "Wars, truces and alliances"
msgstr "Войны, перемирия и союзы"

msgctxt "ui_mcm_lst_fotz_news_all"
msgid "Everything"
msgstr "Всё"

msgctxt "ui_mcm_fotz_census"
msgid "Keep a census"
msgstr "Вести перепись"

msgctxt "ui_mcm_fotz_census_desc"
msgid "Once a game day, and once after each load, count every faction's squads and the ground they hold, and write it to fotz_census.jsonl in the game's appdata folder. It changes nothing in the game."
msgstr "Раз в игровые сутки и после каждой загрузки считать отряды каждой фракции и занятую ими территорию и записывать это в fotz_census.jsonl в папке appdata игры. На игру это не влияет."

msgctxt "ui_mcm_fotz_about"
msgid "Relations change only between factions the base game lets change, within lore limits. Factions of the Zone steps aside while the base game's dynamic relations, Fluid Relations, Dynamic Faction Relations Customizer, or Warfare mode handle relations."
msgstr "Отношения меняются только между группировками, которым это позволяет сама игра, и в пределах лора. Мод уступает, пока отношениями занимаются динамические отношения самой игры, Fluid Relations, Dynamic Faction Relations Customizer или режим «Война группировок»."

msgctxt "st_fotz_news_war_kills"
msgid "Too many of ours have died at the hands of {b}. From today we are at war with them."
msgstr "Слишком много наших погибло от рук группировки «{b}». С сегодняшнего дня мы с ними воюем."

msgctxt "st_fotz_news_war_ground"
msgid "{b} took {place} from us. From today we are at war with them."
msgstr "Группировка «{b}» отняла у нас позицию «{place}». С сегодняшнего дня мы с ними воюем."

msgctxt "st_fotz_news_war_front"
msgid "We have fought {b} at {place} for days. From today we are at war with them."
msgstr "Который день мы бьёмся с группировкой «{b}» у позиции «{place}». С сегодняшнего дня мы с ними воюем."

msgctxt "st_fotz_news_truce"
msgid "The line with {b} has gone quiet. We hold our fire, for now."
msgstr "На линии с группировкой «{b}» стало тихо. Пока не стреляем."

msgctxt "st_fotz_news_alliance"
msgid "We stand with {b} against {enemy}. Treat them as friends."
msgstr "Мы вместе с группировкой «{b}» против группировки «{enemy}». Относитесь к ним как к друзьям."

msgctxt "st_fotz_news_alliance_plain"
msgid "We are allies of {b} now. Treat them as friends."
msgstr "Теперь мы союзники группировки «{b}». Относитесь к ним как к друзьям."

msgctxt "st_fotz_news_alliance_over"
msgid "Our alliance with {b} is over."
msgstr "Наш союз с группировкой «{b}» окончен."

msgctxt "st_fotz_news_ground"
msgid "We took {place} from {b}."
msgstr "Мы заняли позицию «{place}», выбив оттуда группировку «{b}»."

msgctxt "fotz_own"
msgid "Your faction"
msgstr "Ваша группировка"

msgctxt "actor_fotz_own"
msgid "Your faction"
msgstr "Ваша группировка"

msgctxt "st_fotz_default_name"
msgid "Your faction"
msgstr "Ваша группировка"

msgctxt "ui_mcm_fotz_faction"
msgid "Lead a faction of your own"
msgstr "Своя группировка"

msgctxt "ui_mcm_fotz_faction_desc"
msgid "Found a faction of your own. It starts with the friends and enemies of the faction you came from, and your companions join it. Turned off, it is disbanded and everyone goes back to their old faction. No save ever holds it, so removing the mod later needs nothing."
msgstr "Основать свою группировку. Её друзья и враги поначалу те же, что у вашей прежней группировки, а ваши спутники вступают в неё. Если выключить, группировка распускается и все возвращаются в свои прежние группировки. Ни одно сохранение её не содержит, поэтому удаление мода потом ничего не требует."

msgctxt "ui_mcm_fotz_faction_name"
msgid "Its name"
msgstr "Название"

msgctxt "ui_mcm_fotz_faction_name_desc"
msgid "What your faction is called in the news."
msgstr "Как ваша группировка называется в новостях."

msgctxt "ui_mcm_fotz_faction_join"
msgid "You join it"
msgstr "Вы вступаете в неё"

msgctxt "ui_mcm_fotz_faction_join_desc"
msgid "Off unless you choose it: you lead your faction from your old one and keep its traders, tasks and dialogs. On, you stand in your faction yourself and its friends and enemies are yours, but G.A.M.M.A. doesn't know your faction: the disguise system thinks you're in disguise, and traders, tasks, dialogs and fast travel tied to your old faction treat you as an outsider."
msgstr "Выключено, если вы не выберете иначе: вы руководите группировкой, оставаясь в прежней, и сохраняете её торговцев, задания и диалоги. Если включить, вы сами состоите в своей группировке, и её друзья и враги становятся вашими, но G.A.M.M.A. её не знает: система маскировки считает вас переодетым, а торговцы, задания, диалоги и быстрое перемещение прежней группировки считают вас чужаком."

msgctxt "ui_mcm_fotz_faction_companions"
msgid "Companions join it"
msgstr "Спутники вступают в неё"

msgctxt "ui_mcm_fotz_faction_companions_desc"
msgid "Your companions join your faction, and leave it when they leave you."
msgstr "Ваши спутники вступают в вашу группировку и покидают её, когда уходят от вас."

msgctxt "st_fotz_news_founded"
msgid "{name} is founded. Its friends and enemies start as your old faction's."
msgstr "Группировка «{name}» основана. Её друзья и враги поначалу те же, что у вашей прежней группировки."

msgctxt "st_fotz_news_joined"
msgid "{who} has joined {name}."
msgstr "{who} вступает в группировку «{name}»."

msgctxt "st_fotz_news_left"
msgid "{who} has left {name}."
msgstr "{who} покидает группировку «{name}»."

msgctxt "st_fotz_news_disbanded"
msgid "{name} is disbanded. Everyone goes back to their old faction."
msgstr "Группировка «{name}» распущена. Все возвращаются в свои прежние группировки."

